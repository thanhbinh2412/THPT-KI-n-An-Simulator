{
  "name": "back-to-school",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "tsx server.ts --production",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "campus:validate": "node tools/campus/validate_v02_gameplay.mjs",
    "campus:export": "blender -b assets/school/Campus-Rebuild/v02/kien_an_campus_photo_v02.blend --python tools/campus/export_v02_gameplay.py",
    "campus:prepare": "node tools/prepare-campus-preview.mjs",
    "campus:preview": "npm run dev",
    "predev": "npm run campus:prepare",
    "prebuild": "npm run campus:prepare"
  },
  "dependencies": {
    "@next/env": "^15.3.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.1.0",
    "@react-three/rapier": "^2.1.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.176.0",
    "tsx": "^4.23.15",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.176.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
